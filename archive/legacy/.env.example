# 이 파일을 .env로 복사한 뒤 로컬 값으로 채웁니다. .env는 Git에서 제외됩니다.
# URL의 비밀번호에 @, : 같은 문자가 있으면 URL 인코딩이 필요합니다.
MACHINE_DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@localhost:3306/predictive_maintenance
DASHBOARD_ADMIN_INVITE_CODE=
# 32바이트 랜덤 키를 Base64로 인코딩한 값. 예: Python secrets.token_bytes(32) 사용.
DASHBOARD_AES_KEY=BASE64_ENCODED_32_BYTE_KEY
# 로그인에 사용할 단일 관리자 계정. 실제 값은 Git에 올리지 않는 .env에만 둔다.
DASHBOARD_ADMIN_ID=YOUR_ADMIN_ID
DASHBOARD_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
# Flask 로그인 세션 서명용 32바이트 이상 무작위 문자열. 실제 값은 .env에만 저장.
DASHBOARD_SESSION_SECRET=RANDOM_LONG_SESSION_SECRET
# HTTPS 배포일 때만 1. 현재 localhost HTTP에서는 0.
DASHBOARD_COOKIE_SECURE=0
